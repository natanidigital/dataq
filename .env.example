DATABASE_URL="postgresql://user:password@localhost:5432/dataq"
AUTH_SECRET="generate-with-openssl-rand-base64-33"
NEXTAUTH_URL="https://dataq.space"
AUTH_TRUST_HOST=true

# Total outbound bandwidth allowance for this VPS plan, in GB — used only to
# render the "bandwidth used vs. total" pie chart on the admin dashboard.
TOTAL_BANDWIDTH_GB=1000

# Where uploaded image bytes are stored: "local" (this server's disk, the
# default) or "s3" (any S3-compatible object store — Cloudflare R2, Backblaze
# B2, AWS S3). Existing images keep being read from whatever backend they
# were uploaded under, so this can be switched on later.
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=s3. For Cloudflare R2, S3_ENDPOINT is
# https://<account-id>.r2.cloudflarestorage.com and S3_REGION is "auto".
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. A read-only CDN / custom-domain base that serves the bucket
# (e.g. an R2 public bucket URL or a domain bound to it). When set, public
# images are redirected straight here and their bytes never pass through the
# app server. Leave blank to proxy every image through the app instead.
S3_PUBLIC_BASE_URL=
