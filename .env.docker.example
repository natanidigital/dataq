# Copy to .env for `docker compose up` — install.sh does this automatically
# and fills in POSTGRES_PASSWORD / AUTH_SECRET / DOMAIN for you.

POSTGRES_USER=dataq
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dataq

AUTH_SECRET=changeme

# Leave blank for IP-only access (no automatic HTTPS). Set this if you're
# using the optional Caddy reverse proxy (`docker compose --profile
# with-proxy up -d`) and want automatic Let's Encrypt HTTPS for a real
# domain that already points at this server.
DOMAIN=
NEXTAUTH_URL=http://localhost:3000

# Port the app itself listens on (behind whatever reverse proxy you use,
# including Caddy above).
APP_PORT=3000

# Monthly outbound bandwidth allowance shown on the admin dashboard's usage
# chart — match this to your VPS plan.
TOTAL_BANDWIDTH_GB=1000

# Where uploaded images are stored. "local" (default) keeps them in the
# dataq_storage volume on this server. Set "s3" to offload them to a
# Cloudflare R2 / S3-compatible bucket instead, and fill in the block below.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional read-only CDN / custom-domain base for the bucket. When set,
# public images are served straight from there — their bytes never touch
# this server.
S3_PUBLIC_BASE_URL=

# Optional real virus scanning for uploads (on top of the always-on image
# format validation). Leave blank to skip it. To enable: set this to
# "clamav" and start the stack with the extra profile:
#   docker compose --profile with-clamav up -d
# First boot is slow (ClamAV downloads virus definitions) and it uses
# roughly 1-1.5GB of extra RAM.
CLAMAV_HOST=
